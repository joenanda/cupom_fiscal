# Porta do Servidor HTTP
PORT=3333
NODE_ENV=development

# Certificado Digital A1 (Caminho local ou relativo para ambiente de desenvolvimento)
CERTIFICATE_PATH=./storage/certificates/certificado.pfx
CERTIFICATE_PASSWORD=sua_senha_do_certificado

# Provedor Fiscal: 'SEFAZ' (direto via webservice SOAP) ou 'API_ADAPTER' (ex: Focus NFe, Nuvemfiscal)
INTEGRATION_PROVIDER=SEFAZ

# Ambiente SEFAZ: 1 = Produção, 2 = Homologação
SEFAZ_TP_AMB=2

# Configuração de API de Terceiros (Caso utilize INTEGRATION_PROVIDER=API_ADAPTER)
FOCUS_NFE_TOKEN=seu_token_focus_nfe
FOCUS_NFE_ENV=homologacao

# Armazenamento de Arquivos Físicos (XML e DANFE PDF)
STORAGE_DISK=local
STORAGE_LOCAL_DIR=./storage/documents

# Publicação Automática no GitHub e Atualizações
# Gere um Personal Access Token com permissão 'repo' em https://github.com/settings/tokens
GITHUB_TOKEN=ghp_seu_token_aqui
